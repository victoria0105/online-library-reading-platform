rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validLibraryDocument(bookId) {
      return request.resource.data.bookId == bookId
        && request.resource.data.progressPercent is number
        && request.resource.data.progressPercent >= 0
        && request.resource.data.progressPercent <= 100;
    }

    // Each profile belongs only to its authenticated Firebase user.
    match /users/{userId} {
      allow create, read, update, delete: if isOwner(userId);

      // Saved books, Google Books metadata snapshots, status, and progress.
      match /library/{bookId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validLibraryDocument(bookId);
      }

      // Reserved for future reading-history/recommendation work.
      match /readingSessions/{sessionId} {
        allow create, read, update, delete: if isOwner(userId);
      }
    }

    // Optional public curated content. Browser clients cannot write it.
    match /featuredBooks/{itemId} {
      allow read: if true;
      allow write: if false;
    }

    // Optional public book metadata cache. Writes require trusted server code.
    match /bookCache/{bookId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
