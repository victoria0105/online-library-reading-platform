rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Private ReadShelf profile for the signed-in user.
    match /users/{userId} {
      allow create, read, update, delete: if isOwner(userId);

      // Saved books + reading status/progress.
      match /library/{bookId} {
        allow create, read, update, delete: if isOwner(userId);
      }

      // Reserved for future reading-history/recommendation work.
      match /readingSessions/{sessionId} {
        allow create, read, update, delete: if isOwner(userId);
      }
    }

    // Optional public curated lists. Browser clients cannot write them.
    match /featuredBooks/{itemId} {
      allow read: if true;
      allow write: if false;
    }

    // Optional public metadata cache. Writes must come from trusted server code.
    match /bookCache/{bookId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
